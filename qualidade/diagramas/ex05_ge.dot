// Exercício 5 - Grafo de Estados (GE) obtido do Diagrama de Transição de Estados
digraph ge {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=11, nodesep=0.8, ranksep=1.3, pad=0.3,
         label="GE — 5 nós (estados), 14 arestas (transições)  →  sequências independentes = E − N + 2 = 11", labelloc=b];
  node  [shape=circle, fontname="DejaVu Sans", fontsize=11, width=0.55, fixedsize=true, style=filled, fillcolor="#ffffff"];
  edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.6];
  E0 [label="E0", fillcolor="#dddddd"]; E4 [label="E4", shape=doublecircle, fillcolor="#dddddd"];
  E1; E2; E3 [fillcolor="#fdf1e3"];
  E0 -> E1 [label="t1"];
  E1 -> E2 [label="t2"];
  E2 -> E2 [label="t3"];
  E2 -> E2 [label="t4"];
  E2 -> E1 [label="t5"];
  E1 -> E3 [label="t6"];
  E2 -> E3 [label="t7"];
  E3 -> E3 [label="t8"];
  E3 -> E3 [label="t9"];
  E3 -> E2 [label="t10"];
  E3 -> E1 [label="t11"];
  E1 -> E4 [label="t12"];
  E2 -> E4 [label="t13"];
  E3 -> E4 [label="t14"];
  legenda [shape=note, fixedsize=false, fontsize=9, fillcolor="#fffef2", label="E0 = estado inicial\lE1 = Aberta sem inscritos\lE2 = Aberta com inscritos\lE3 = Encerrada\lE4 = Excluída (final)\l"];
}

  codigo [shape=note, fixedsize=false, fontname="DejaVu Sans Mono", fontsize=13, fillcolor="#fffef2", label="1  if (comunicacaoId == null)\l2    throw campanhaSemId\l3  if (!campanha.ehCampanha)\l4    throw naoECampanha\l5  if (usuarioId == null)\l6    throw usuarioNaoIdentificado\l7  if (escolhidos.length > 11)\l8    throw limiteDeParticipantes\l9  encerrada = ...; falhas = []; alteracoes = 0\l10 for (participante in participantes)\l11   if (estava == deve) continue\l12   if (deveEstarInscrito)\l13     if (encerrada)\l14       falhas.add(...); continue\l15     if (!participante.vinculoAtivo)\l16       falhas.add(...); continue\l17   try { if (deveEstarInscrito)\l18       await inscrever(...)\l19     else await desinscrever(...)\l20     alteracoes++ }\l21   catch (erro) { falhas.add(...) }\l22 return ResultadoInscricao(...)\l23 (saída)\l"];

@startuml ex04_atividades_uml_parte1
' Exercício 4 (parte 1) - Diagrama de Atividades (UML) com raias - UC03 Inscrever-se em campanha.
' Os números [n] são os nós do Grafo de Fluxo de Controle (Figura 4).
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor #FFE3B3
skinparam ActivityDiamondFontSize 15
skinparam ArrowFontSize 15
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleFontSize 16

|#F6F9FD|Cidadão|
start
:[1] Abrir detalhes da campanha;
|#F4F9F1|Sistema Conecta Vida|
:[1] Exibir detalhes e situação;
|Cidadão|
:[1] Tocar em "gerenciar inscrições";
|Sistema Conecta Vida|
if ([2] Encerrada ou lotada, sem\ninscrições? (RN02/RN07)) then (sim)
  #FDE8E8:[3] Mensagem de recusa (E1/E5);
  stop
else (não)
endif
if ([4] Campanha (RN01), ID (E2)\ne usuário (E3) válidos?) then (não)
  #FDE8E8:[5] Mensagem de erro (E2/E3);
  stop
else (sim)
endif
|#FDF8EF|Supabase|
:[6] Buscar dependentes ativos\ne inscrições (RN03);
|Sistema Conecta Vida|
:[6] Exibir participantes (A4: se\nencerrada ou lotada, só desmarcar);
|Cidadão|
:[6] Marcar / desmarcar;
if ([7] Confirmou?) then (não, A2)
  stop
else (sim)
endif
|Sistema Conecta Vida|
if ([8] Houve alteração?) then (não)
  #FFF6E0:[9] "Nenhuma alteração" (A3);
  stop
else (sim)
endif
if ([10] Novas marcações cabem\nnas vagas? (RN07)) then (não)
  #FDE8E8:[11] "Restam N vaga(s) nesta\ncampanha" (E6);
  stop
else (sim)
endif
(A)
detach
@enduml

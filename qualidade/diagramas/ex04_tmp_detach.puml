@startuml ex04_tmp_detach
' Exercício 4 (parte 2) - Diagrama de Atividades (UML) com raias - UC03 Inscrever-se em campanha.
' Os números [n] são os nós do Grafo de Fluxo de Controle (Figura 4).
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor #FFE3B3
skinparam ActivityDiamondFontSize 14
skinparam ArrowFontSize 14
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleFontSize 16

|#F4F9F1|Sistema Conecta Vida|
|#FDF8EF|Supabase|
|Sistema Conecta Vida|
(A)
while ([10] Há participante\nalterado?) is (sim)
  if ([11] Marcado para\ninscrever?) then (sim)
    if ([12] Aberta e\nvínculo ativo?\n(RN02/03/06)) then (não)
      #FDE8E8:[13] Registrar\nrecusa;
      -> volta ao [10];
      detach
    else (sim)
      |Supabase|
      :[14] Gravar inscrição\n(RN01, RN03, RN04);
      |Sistema Conecta Vida|
    endif
  else (não, A1)
    |Supabase|
    :[15] Remover\ninscrição (RN05);
    |Sistema Conecta Vida|
  endif
  if ([16] Gravou?) then (não)
    #FDE8E8:[17] Registrar\nfalha (E4);
  else (sim)
  endif
endwhile (não)
if ([18] Falhas ou\nrecusas?) then (sim)
  #FDE8E8:[19] "Algumas não\nforam atualizadas";
else (não)
  #E6F4E1:[20] "Inscrições\natualizadas (N)";
endif
stop
@enduml

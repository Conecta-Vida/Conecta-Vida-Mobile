@startuml ex05_estados_uml
' Exercício 5 - Diagrama de Transição de Estados (UML) do objeto Campanha
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 11
skinparam StateBackgroundColor #EEF4FB
skinparam StateBorderColor #4A78B5
skinparam ArrowFontSize 10
left to right direction
hide empty description
title Campanha (tabela comunicacoes, tipo CAMPANHA)

state "Aberta sem inscritos" as E1 : status = ATIVA\ninscrições = 0
state "Aberta com inscritos" as E2 : status = ATIVA\ninscrições ≥ 1
state "Encerrada" as E3 #FDF1E3 : status = ENCERRADA\nsó aceita cancelamento

[*] --> E1 : t1: publicar(campanha)\n[gestor ou calendário de saúde]
E1 --> E2 : t2: inscrever(participante)\n[RN01 ∧ RN03 ∧ RN04 ∧ RN06]
E2 --> E2 : t3: inscrever(participante)\n[RN01 ∧ RN03 ∧ RN04 ∧ RN06]
E2 --> E2 : t4: cancelar(participante)\n[inscrições > 1]
E2 --> E1 : t5: cancelar(participante) ou revogar dependente\n[inscrições = 1] / RN05
E1 --> E3 : t6: encerrar\n[data_fim < agora (pg_cron 03h05) ou gestor]
E2 --> E3 : t7: encerrar\n[data_fim < agora (pg_cron 03h05) ou gestor]
E3 --> E3 : t8: cancelar(participante)\n[inscrições ≥ 1] (A4)
E3 --> E3 : t9: inscrever(participante)\n/ recusar (RN02)
E3 --> E2 : t10: reabrir\n[gestor muda para ATIVA ∧ inscrições ≥ 1]
E3 --> E1 : t11: reabrir\n[gestor muda para ATIVA ∧ inscrições = 0]
E1 --> [*] : t12: excluir [gestor]
E2 --> [*] : t13: excluir [gestor]\n/ remove inscrições
E3 --> [*] : t14: excluir [gestor]\n/ remove inscrições
@enduml

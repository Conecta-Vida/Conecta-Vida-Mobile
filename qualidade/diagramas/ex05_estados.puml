@startuml ex05_estados_uml
' Exercício 5 - Diagrama de Transição de Estados (UML) do objeto Campanha
' (tabela comunicacoes, tipo CAMPANHA). Transições no formato evento [guarda] / ação.
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam StateFontSize 16
skinparam StateAttributeFontSize 14
skinparam ArrowFontSize 14
skinparam StateBackgroundColor #EEF4FB
skinparam StateBorderColor #4A78B5
hide empty description
top to bottom direction

state "Aberta sem inscritos" as E1 : status = ATIVA\ninscrições = 0
state "Aberta com inscritos" as E2 : status = ATIVA\ninscrições ≥ 1
state "Encerrada" as E3 #FDF1E3 : status = ENCERRADA\n(só cancelamento)

[*] --> E1 : t1: publicar\n[gestor ou calendário]
E1 --> E2 : t2: inscrever\n[RN01∧RN03∧RN04∧RN06]
E2 --> E2 : t3: inscrever\n[RN01∧RN03∧RN04∧RN06]
E2 --> E2 : t4: cancelar\n[inscrições > 1]
E2 --> E1 : t5: cancelar ou revogar\ndependente [inscrições = 1]\n/ RN05
E1 --> E3 : t6: encerrar\n[data_fim < agora\nou gestor]
E2 --> E3 : t7: encerrar\n[data_fim < agora\nou gestor]
E3 --> E3 : t8: cancelar\n[inscrições ≥ 1] (A4)
E3 --> E3 : t9: inscrever\n/ recusar (RN02)
E3 --> E2 : t10: reabrir\n[ATIVA ∧ inscrições ≥ 1]
E3 --> E1 : t11: reabrir\n[ATIVA ∧ inscrições = 0]
E1 --> [*] : t12: excluir\n[gestor]
E2 --> [*] : t13: excluir [gestor]\n/ remove inscrições
E3 --> [*] : t14: excluir [gestor]\n/ remove inscrições
@enduml

// Exercício 2 - Diagrama de Classes do caso de uso "Inscrever-se em campanha"
digraph classes {
  graph [rankdir=BT, fontname="DejaVu Sans", fontsize=11, nodesep=0.5, ranksep=0.9, pad=0.3];
  node  [shape=record, fontname="DejaVu Sans", fontsize=9, style=filled, fillcolor="#ffffff"];
  edge  [fontname="DejaVu Sans", fontsize=8];

  subgraph cluster_app {
    label="«pacote» aplicacao (lib/usecases)"; style="rounded,filled"; fillcolor="#eef4fb"; color="#4a78b5";
    Service [fillcolor="#ffffff", label="{«use case / service»\nInscricaoCampanhaService|+ limiteDependentes: int = 10 \{static\}\l+ limiteParticipantes: int = 11 \{static\}\l- repositorio: InscricaoRepository\l- agora: DateTime Function()\l|+ verificarAcesso(campanha: NewsModel, usuarioId: int?, possuiInscricoes: bool): void\l+ inscricoesDoUsuario(comunicacaoId: int, usuarioId: int): Future\<List\<Inscricao\>\>\l+ listarParticipantes(usuarioId: int, inscricoesAtuais: List\<Inscricao\>): Future\<List\<Participante\>\>\l+ salvarInscricoes(campanha: NewsModel, usuarioId: int?, participantes: List\<Participante\>,\l      inscritosAtuais: Set\<String\>, escolhidos: Set\<String\>): Future\<ResultadoInscricao\>\l}"];
    Repo [label="{«interface»\nInscricaoRepository||+ buscarDependentesAtivos(usuarioId: int): Future\<List\<DependenteModel\>\>\l+ buscarInscricoes(comunicacaoId: int): Future\<List\<Inscricao\>\>\l+ inscrever(comunicacaoId: int, usuarioId: int, dependenteId: int?): Future\<void\>\l+ desinscrever(comunicacaoId: int, usuarioId: int, dependenteId: int?): Future\<void\>\l}"];
    Resultado [label="{ResultadoInscricao|+ alteracoes: int\l+ selecionados: int\l+ falhas: List\<String\>\l|+ sucessoTotal(): bool\l+ mensagem(tituloCampanha: String): String\l}"];
    Excecao [label="{InscricaoException|+ motivo: MotivoRecusa\l|+ mensagem(): String\l}"];
    Motivo [label="{«enumeration»\nMotivoRecusa|campanhaSemId\lnaoECampanha\lcampanhaEncerrada\lusuarioNaoIdentificado\llimiteDeParticipantes\l}"];
  }

  subgraph cluster_dom {
    label="«pacote» dominio (lib/models)"; style="rounded,filled"; fillcolor="#f2f8ee"; color="#5b9a3c";
    Campanha [label="{«entity»\nNewsModel (Comunicação / Campanha)|+ id: int?\l+ tag: String  (CAMPANHA \| NOTICIA \| ALERTA)\l+ titulo: String\l+ categoria: String\l+ local: String\l+ dataInicio: String\l+ dataFim: String\l+ status: String  (ATIVA \| ENCERRADA)\l|+ ehCampanha(): bool\l+ encerrada(): bool\l+ encerradaEm(hoje: DateTime): bool\l}"];
    Inscricao [label="{«entity»\nInscricao|+ id: int?\l+ usuarioId: int\l+ comunicacaoId: int\l+ dependenteId: int?\l+ participanteNome: String\l+ parentesco: String\l|+ doTitular(): bool\l+ chaveParticipante(): String\l}"];
    Participante [label="{«entity»\nParticipante|+ dependenteId: int?\l+ nome: String\l+ parentesco: String\l+ vinculoAtivo: bool\l|+ ehTitular(): bool\l+ chave(): String\l}"];
    Dependente [label="{«entity»\nDependenteModel|+ id: int?\l+ nomeCompleto: String\l+ dataNascimento: DateTime\l+ parentesco: String\l+ status: String  (pendente \| ativo \| revogado)\l+ emailDependente: String?\l+ declarouResponsabilidade: bool\l|+ ativo(): bool\l+ idadeEm(nascimento: DateTime, hoje: DateTime): int\l}"];
    Usuario [label="{«entity»\nUserModel (Titular)|+ id: int?\l+ nome: String\l+ email: String\l+ dataNascimento: int?\l+ localizacao: String\l+ permissao: String\l}"];
  }

  // Navegabilidade (associações) e multiplicidades
  Service -> Repo [arrowhead=vee, label=" -repositorio\n1", fontcolor="#4a78b5"];
  Excecao -> Motivo [arrowhead=vee, label=" motivo 1"];
  Inscricao -> Usuario [arrowhead=vee, label=" titular  1"];
  Inscricao -> Campanha [arrowhead=vee, label=" campanha  1"];
  Inscricao -> Dependente [arrowhead=vee, label=" participante  0..1"];
  Dependente -> Usuario [arrowhead=vee, label=" titular  1\n(até 10 dependentes)"];

  // Dependências (uso)
  edge [style=dashed, arrowhead=vee, label="«use»", color="#555555", fontcolor="#555555"];
  Service -> Campanha;
  Service -> Inscricao;
  Service -> Participante;
  Service -> Resultado [label="«create»"];
  Service -> Excecao [label="«throw»"];
  Repo -> Dependente;
  Repo -> Inscricao;
}

// Exercício 5 - Diagrama de Transição de Estados da Campanha (comunicacoes, tipo CAMPANHA)
digraph dte {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=11, nodesep=0.9, ranksep=1.5, pad=0.3];
  node  [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#4a78b5", penwidth=1.4];
  edge  [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7];
  ini [shape=circle, style=filled, fillcolor=black, label="", width=0.22];
  fim [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.15];
  S1 [label="Aberta sem inscritos\n─────────────\nstatus = ATIVA\ninscrições = 0"];
  S2 [label="Aberta com inscritos\n─────────────\nstatus = ATIVA\ninscrições ≥ 1"];
  S3 [label="Encerrada\n─────────────\nstatus = ENCERRADA\n(só aceita cancelamento)", fillcolor="#fdf1e3", color="#c9892b"];

  ini -> S1 [label="t1: publicar(campanha)\n[gestor no painel ou calendário de saúde]"];
  S1 -> S2 [label="t2: inscrever(participante)\n[RN01 ∧ RN03 ∧ RN04 ∧ RN06]"];
  S2 -> S2 [label="t3: inscrever(participante)\n[RN01 ∧ RN03 ∧ RN04 ∧ RN06]"];
  S2 -> S2 [label="t4: cancelar(participante)\n[inscrições > 1]"];
  S2 -> S1 [label="t5: cancelar(participante) ou revogar dependente\n[inscrições = 1] / RN05"];
  S1 -> S3 [label="t6: encerrar\n[data_fim < agora (pg_cron 03h05) ou gestor]"];
  S2 -> S3 [label="t7: encerrar\n[data_fim < agora (pg_cron 03h05) ou gestor]"];
  S3 -> S3 [label="t8: cancelar(participante)\n[inscrições ≥ 1] (A4)"];
  S3 -> S3 [label="t9: inscrever(participante)\n/ recusar (RN02)", color="#c0392b", fontcolor="#c0392b"];
  S3 -> S2 [label="t10: reabrir\n[gestor muda para ATIVA ∧ inscrições ≥ 1]"];
  S3 -> S1 [label="t11: reabrir\n[gestor muda para ATIVA ∧ inscrições = 0]"];
  S1 -> fim [label="t12: excluir [gestor]"];
  S2 -> fim [label="t13: excluir [gestor]\n/ remove inscrições (cascade)"];
  S3 -> fim [label="t14: excluir [gestor]\n/ remove inscrições (cascade)"];
}

  InscricaoCampanhaService [pos="775,280.5", label="{InscricaoCampanhaService|-repositorio: InscricaoRepository\l-agora: DateTime Function()\l|+verificarAcesso(campanha: NewsModel,\l      usuarioId: int?,\l      possuiInscricoes: bool): void\l+inscricoesDoUsuario(comunicacaoId: int,\l      usuarioId: int):\l      Future&lt;List&lt;Inscricao&gt;&gt;\l+listarParticipantes(usuarioId: int,\l      inscricoesAtuais: List&lt;Inscricao&gt;):\l      Future&lt;List&lt;Participante&gt;&gt;\l+salvarInscricoes(campanha: NewsModel,\l      usuarioId: int?,\l      participantes: List&lt;Participante&gt;,\l      inscritosAtuais: Set&lt;String&gt;,\l      escolhidos: Set&lt;String&gt;):\l      Future&lt;ResultadoInscricao&gt;\l}"];
}
subgraph cluster_1 { label="«pacote» dominio"; style="rounded,filled"; fillcolor="#f2f8ee"; color=gray40; fontname="DejaVu Sans"; fontsize=13; labelloc=t; bb="20,500,880,572";

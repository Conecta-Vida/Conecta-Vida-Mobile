digraph classes {
rankdir=BT; nodesep=0.25; ranksep=0.5; pad=0.1; concentrate=true;
node [shape=record, fontname="DejaVu Sans", fontsize=12, style=filled, fillcolor="#ffffff"];
edge [fontname="DejaVu Sans", fontsize=11];
subgraph cluster_0 { label="«pacote» aplicacao"; style="rounded,filled"; fillcolor="#eef4fb"; color=gray40; fontname="DejaVu Sans"; fontsize=13; labelloc=t;
  InscricaoRepository [label="{«abstract»\nInscricaoRepository||+buscarDependentesAtivos(usuarioId: int):\l      Future&lt;List&lt;DependenteModel&gt;&gt;\l+buscarInscricoes(comunicacaoId: int):\l      Future&lt;List&lt;Inscricao&gt;&gt;\l+inscrever(comunicacaoId: int,\l      usuarioId: int,\l      dependenteId: int?):\l      Future&lt;void&gt;\l+desinscrever(comunicacaoId: int,\l      usuarioId: int,\l      dependenteId: int?):\l      Future&lt;void&gt;\l}"];
  MotivoRecusa [label="{«enumeration»\nMotivoRecusa|campanhaSemId\lnaoECampanha\lcampanhaEncerrada\lusuarioNaoIdentificado\llimiteDeParticipantes\l|}"];
  InscricaoException [label="{InscricaoException|+motivo: MotivoRecusa\l|+mensagem: String\l+toString(): String\l}"];
  ResultadoInscricao [label="{ResultadoInscricao|+alteracoes: int\l+selecionados: int\l+falhas: List&lt;String&gt;\l|+sucessoTotal: bool\l+mensagem(tituloCampanha: String):\l      String\l}"];
  InscricaoCampanhaService [label="{InscricaoCampanhaService|+limiteDependentes: int\l+limiteParticipantes: int\l-repositorio: InscricaoRepository\l-agora: DateTime Function()\l|+verificarAcesso(campanha: NewsModel,\l      usuarioId: int?,\l      possuiInscricoes: bool): void\l+inscricoesDoUsuario(comunicacaoId: int,\l      usuarioId: int):\l      Future&lt;List&lt;Inscricao&gt;&gt;\l+listarParticipantes(usuarioId: int,\l      inscricoesAtuais: List&lt;Inscricao&gt;):\l      Future&lt;List&lt;Participante&gt;&gt;\l+salvarInscricoes(campanha: NewsModel,\l      usuarioId: int?,\l      participantes: List&lt;Participante&gt;,\l      inscritosAtuais: Set&lt;String&gt;,\l      escolhidos: Set&lt;String&gt;):\l      Future&lt;ResultadoInscricao&gt;\l}"];
}
subgraph cluster_1 { label="«pacote» dominio"; style="rounded,filled"; fillcolor="#f2f8ee"; color=gray40; fontname="DejaVu Sans"; fontsize=13; labelloc=t;
  Inscricao [shape=box, label="Inscricao"];
  Participante [shape=box, label="Participante"];
  NewsModel [shape=box, label="NewsModel"];
  DependenteModel [shape=box, label="DependenteModel"];
  ConviteDependente [shape=box, label="ConviteDependente"];
}
subgraph cluster_2 { label="«pacote» infraestrutura"; style="rounded,filled"; fillcolor="#fff6e6"; color=gray40; fontname="DejaVu Sans"; fontsize=13; labelloc=t;
  SupabaseInscricaoRepository [label="{SupabaseInscricaoRepository||+buscarDependentesAtivos(usuarioId: int):\l      Future&lt;List&lt;DependenteModel&gt;&gt;\l+buscarInscricoes(comunicacaoId: int):\l      Future&lt;List&lt;Inscricao&gt;&gt;\l+inscrever(comunicacaoId: int,\l      usuarioId: int,\l      dependenteId: int?):\l      Future&lt;void&gt;\l+desinscrever(comunicacaoId: int,\l      usuarioId: int,\l      dependenteId: int?):\l      Future&lt;void&gt;\l}"];
}
  Inscricao -> Participante [arrowhead=vee, style=dashed];
  InscricaoCampanhaService -> Inscricao [arrowhead=vee, style=dashed];

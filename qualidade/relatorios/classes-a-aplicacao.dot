  InscricaoCampanhaService -> ResultadoInscricao [arrowhead=vee, style=dashed];
  InscricaoException -> InscricaoCampanhaService [arrowhead=vee, style=dashed];
  InscricaoException -> MotivoRecusa [arrowhead=vee];
  InscricaoRepository -> DependenteModel [arrowhead=vee, style=dashed];
  InscricaoRepository -> Inscricao [arrowhead=vee, style=dashed];
  SupabaseInscricaoRepository -> DependenteModel [arrowhead=vee, style=dashed];

digraph classes {
rankdir=BT; nodesep=0.25; ranksep=0.5; pad=0.1; concentrate=true;
node [shape=record, fontname="DejaVu Sans", fontsize=12, style=filled, fillcolor="#ffffff"];
edge [fontname="DejaVu Sans", fontsize=11];
subgraph cluster_0 { label="«pacote» dominio"; style="rounded,filled"; fillcolor="#f2f8ee"; color=gray40; fontname="DejaVu Sans"; fontsize=13; labelloc=t;
  Inscricao [label="{Inscricao|+id: int?\l+usuarioId: int\l+comunicacaoId: int\l+dependenteId: int?\l+participanteNome: String\l+parentesco: String\l|+doTitular: bool\l+chaveParticipante: String\l-inteiro(valor: Object?):\l      int? \{static\}\l}"];
  Participante [label="{Participante|+dependenteId: int?\l+nome: String\l+parentesco: String\l+vinculoAtivo: bool\l|+ehTitular: bool\l+chave: String\l+chaveDe(dependenteId: int?):\l      String \{static\}\l}"];
  NewsModel [label="{NewsModel|+id: int?\l+tag: String\l+data: String\l+dataInicio: String\l+dataFim: String\l+titulo: String\l+subtitulo: String\l+descricao: String\l+imagem: String\l+categoria: String\l+local: String\l+publicoAlvo: String\l+textoBotaoAcao: String\l+orgao: String\l+orgaoTelefone: String\l+orgaoSite: String\l+status: String\l+fonteUrl: String\l+vagas: int?\l+inscritos: int\l+abrangenciasAmplas\l|+vagasRestantes: int?\l+lotada: bool\l+comportaNovas(quantidade: int):\l      bool\l+abrangenciaGeral: bool\l+localEhCidade: bool\l+ehCampanha: bool\l+tipoLegivel: String\l+dataLegivel: String\l+encerrada: bool\l+encerradaEm(hoje: DateTime): bool\l-inteiroOuNulo(valor: dynamic):\l      int? \{static\}\l+toMap(): Map&lt;String, dynamic&gt;\l}"];
  DependenteModel [label="{DependenteModel|+id: int?\l+nomeCompleto: String\l+dataNascimento: DateTime\l+parentesco: String\l+sexo: String?\l+status: String\l+emailDependente: String?\l+declarouResponsabilidade: bool\l|+pendente: bool\l+ativo: bool\l+idadeEm(nascimento: DateTime,\l      hoje: DateTime): int \{static\}\l+exigeAutorizacaoDoDependente(nascimento: DateTime,\l      parentesco: String,\l      hoje: DateTime?):\l      bool \{static\}\l+toRequestMap(): Map&lt;String,\l      dynamic&gt;\l}"];
  ConviteDependente [label="{ConviteDependente|+id: int\l+titularNome: String\l+parentesco: String\l+status: String\l|+pendente: bool\l}"];
}
  Inscricao -> Participante [arrowhead=vee, style=dashed];
}
# Configuração do app Conecta Vida (sem segredos: este arquivo é versionado).
#
# URL da mobile-api. Se ficar comentada, o app usa o padrão:
#   - Emulador Android:        http://10.0.2.2:8081/api
#   - Chrome / desktop / iOS:  http://localhost:8081/api
# Celular físico na mesma rede Wi-Fi: use o IP do PC que roda o Docker.
# Também é possível definir no build: flutter run --dart-define=API_BASE_URL=...
#
# API_BASE_URL=http://192.168.0.10:8081/api

# Configuração local opcional do Conecta Vida.
# Não adicione senhas do Supabase, tokens ou chaves privadas neste arquivo.
#
# Para rodar no Chrome com a API local:
#   flutter run -d chrome --web-port=5000 --dart-define=API_BASE_URL=http://localhost:8081/api
#
# Para Web publicado com API em domínio separado, defina no build:
#   --dart-define=API_BASE_URL=https://SUA-API.onrender.com/api
#
# Sem API_BASE_URL:
#   - Flutter Web: /api (mesma origem)
#   - Emulador Android: http://10.0.2.2:8081/api
#   - Desktop/iOS simulator: http://localhost:8081/api
#
# API_BASE_URL=
